# 複製成 .env 再填值：  cp .env.example .env && chmod 600 .env
# .env 絕對不能 commit（內有 DISCORD_TOKEN）。等號兩邊不要有空格，值不要加引號。

# Discord Bot Token（機密）。取得方式見 docs/discord-bot-setup.md
DISCORD_TOKEN=

# 要監看的那一個頻道的 ID（15～20 位數字）。取得方式見 docs/discord-server-setup.md
CHANNEL_ID=

# 傳給 claude -p 的模型名稱或別名
CLAUDE_MODEL=

# 紀錄資料夾（Excel、照片、log）。必須是完整路徑，而且在專案資料夾之外，例如 /Users/你的帳號/ticket-data
DATA_DIR=

# --- 以下選填，沒設就用預設值 ---
# RATE_LIMIT_PER_MIN=8
# MAX_ATTACHMENT_MB=10
# CLAUDE_TIMEOUT_S=120
# CLAUDE_RETRIES=2
